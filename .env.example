# === Tərcümə (Gemini) ===
# Birbaşa Google Gemini (Rusiyada işləməyəcək):
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL boş qalsın

# OFOX.ai proxy istifadə etdikdə (Rusiyada test üçün):
# GEMINI_API_KEY=sk-of-xxxxxxxxxxxxxxxx
# GEMINI_MODEL=google/gemini-3.8-flash
# GEMINI_BASE_URL=https://api.ofox.ai/gemini

# === Səsləndirmə (Google Cloud Text-to-Speech) ===
# Bu, OFOX-dan ASILI DEYİL - Cloud Run-un öz Google Cloud kimlik
# məlumatları (ADC) ilə birbaşa işləyir, əlavə API açarı lazım deyil.
# Yalnız Google Cloud Console-da "Cloud Text-to-Speech API"-ni
# aktivləşdirmək kifayətdir:
#   gcloud services enable texttospeech.googleapis.com
#
# Lokal test üçün (Cloud Run-da avtomatik işləyir, bu addım YALNIZ
# öz kompüterində sınamaq üçündür):
#   gcloud auth application-default login
